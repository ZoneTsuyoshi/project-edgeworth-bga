# 作業用ワークツリー（タスクごとに .worktrees/<ブランチ名> を作成する）
.worktrees/

# OS / エディタ
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 依存パッケージ・ビルド生成物
node_modules/
vendor/
dist/
*.log

# 認証情報（BGA Studio の SFTP 情報などは絶対にコミットしない）
.env
.env.*
!.env.example
sftp.json
.vscode/sftp.json
*.pem
id_rsa*
id_ed25519*

# Claude Code のローカル設定
.claude/settings.local.json

# BGA 配布の開発用スタブ（再配布不可。コミットしない。仕様書 005 §2.6）
/tools/bga/_ide_helper.php
/tools/bga/bga-framework.d.ts

# スプライト生成物（CI とローカルで scripts/build-sprites.mjs が生成する。仕様書 012 §7.1）
/src/img/pe_*.webp
/src/img/zoom/
/src/modules/js/cards/sprites.js
/build/

# PHPUnit のキャッシュ
.phpunit.result.cache
