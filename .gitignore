# 作業用ワークツリー（タスクごとに .worktrees/<ブランチ名> を作成する）
.worktrees/

# OS / エディタ
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 依存パッケージ・ビルド生成物
node_modules/
vendor/
dist/
*.log

# 認証情報（BGA Studio の SFTP 情報などは絶対にコミットしない）
.env
.env.*
!.env.example
sftp.json
.vscode/sftp.json
*.pem
id_rsa*
id_ed25519*

# Claude Code のローカル設定
.claude/settings.local.json

# BGA 配布の開発用スタブ（再配布不可。コミットしない。仕様書 005 §2.6）
/tools/bga/_ide_helper.php
/tools/bga/bga-framework.d.ts

# 原本画像（作者の手元だけ。コミットしない。ディレクトリでもシンボリックリンクでも無視するため末尾の / は付けない）
/data

# PHPUnit のキャッシュ
.phpunit.result.cache
# 生成物の置き場。画像の対応表（manifest.json）だけはコミットする（CI の check:sprites が読む）
/build/*
!/build/sprites/
/build/sprites/*
!/build/sprites/manifest.json
