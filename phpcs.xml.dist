<?xml version="1.0"?>
<!-- P2: PHP のコーディング規約（仕様書 004 §6.2、005 §2.5）。実行: composer lint:cs -->
<ruleset name="ProjectEdgeworth">
    <description>PROJECT EDGEWORTH の PHP コーディング規約（PSR-12 ベース）</description>

    <file>src</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- 行長は下で警告ではなくエラーにして 140 文字に緩める -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <!-- 行長を警告からエラーに引き上げる -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <type>error</type>
    </rule>
    <!-- カードの効果文（印刷どおりの 1 文）は 1 行に置く。行長の検査から除外する -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>src/modules/php/Material/CardTexts\.php</exclude-pattern>
    </rule>

    <!-- BGA の debug_ で始まるデバッグ用メソッドは Studio のデバッグメニューに出る仕様（仕様書 004 §6.1） -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/modules/php/Game\.php</exclude-pattern>
    </rule>
</ruleset>
