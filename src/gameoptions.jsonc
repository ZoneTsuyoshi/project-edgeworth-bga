{
  // ゲームオプション（仕様書 004 §7、001 §3）。ID と値のキーは Material/OptionId と Setup/ の enum に一致させる。
  // 値のキーは一度決めたら変えない。値 104=3（Draft）は実装するまで載せない（キーは予約）。100 の 2・5（旧 Random w/o Flip）も廃止した欠番として予約。
  // © だんじり協奏曲 (Danjiri Concerto) https://x.com/danjiriconcerto
  // 101 は displaycondition を使わない（テーブルの最大人数の設定で選択肢が消えるため）。人数に合わない値は startcondition で開始を止める（2026-11-12 作者指示）。
  // コメントは最上位のオブジェクトの中（キーの間）にだけ書く。入れ子のオブジェクトの中には書かない（Studio の commit で Syntax error になった疑い、2026-11-14）。
  "100": {
    "name": "Board layout",
    "values": {
      "1": { "name": "Standard (Earth)" },
      "3": { "name": "Standard (Random)", "tmdisplay": "Standard (Random)" },
      "4": { "name": "Advanced (Earth)", "tmdisplay": "Advanced (Earth)" },
      "6": { "name": "Advanced (Random)", "tmdisplay": "Advanced (Random)" }
    },
    "default": 1,
    "level": "base"
  },
  "101": {
    "name": "Board size",
    "values": {
      "1": { "name": "2x4" },
      "2": { "name": "2x3", "tmdisplay": "Board 2x3" },
      "3": { "name": "2x2", "tmdisplay": "Board 2x2" }
    },
    "default": 1,
    "level": "base",
    "startcondition": {
      "2": [
        {
          "type": "maxplayers",
          "value": 3,
          "message": "The 2x3 board is available only for 2 or 3 players."
        }
      ],
      "3": [
        {
          "type": "maxplayers",
          "value": 2,
          "message": "The 2x2 board is available only for 2 players."
        }
      ]
    }
  },
  "102": {
    "name": "Award cards",
    "values": {
      "1": { "name": "Initial Game" },
      "2": { "name": "Random (1: Link, 1: Other)", "tmdisplay": "Awards: Random (1 Link, 1 Other)" },
      "3": { "name": "Random", "tmdisplay": "Awards: Random" }
    },
    "default": 1,
    "level": "base"
  },
  "103": {
    "name": "Satellite plan",
    "values": {
      "1": { "name": "MOON" },
      "2": { "name": "Player-variable", "tmdisplay": "Player-variable satellite plans" }
    },
    "default": 1,
    "level": "base"
  },
  "104": {
    "name": "Starting hand",
    "values": {
      "1": { "name": "None" },
      "2": { "name": "Mulligan", "tmdisplay": "Mulligan" }
    },
    "default": 1,
    "level": "additional"
  },
  "105": {
    "name": "Public fame (except missions)",
    "values": {
      "1": { "name": "Hidden" },
      "2": { "name": "Visible", "tmdisplay": "Fame is visible during the game (except missions)" }
    },
    "default": 1,
    "level": "additional"
  }
}
