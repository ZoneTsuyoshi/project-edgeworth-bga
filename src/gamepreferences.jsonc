  "100": {
    "name": "Show player marks on pieces",
    "values": {
      "0": { "name": "Off", "cssPref": "pe_marks_off" },
      "1": { "name": "On", "cssPref": "pe_marks_on" }
    },
    "default": 0
  }
}
